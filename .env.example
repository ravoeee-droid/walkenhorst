NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WALKENHORST_CALENDAR_URL=https://www.walkenhorst-eko.de/

# Optional locally. Vercel deployments can authenticate AI Gateway automatically via VERCEL_OIDC_TOKEN.
AI_GATEWAY_API_KEY=
# Optional fallback when the app is not running on Vercel / AI Gateway.
OPENAI_API_KEY=
# Optional override. Defaults to openai/gpt-5.4 on AI Gateway and gpt-5.4 for direct OpenAI.
OPENAI_MODEL=
